NODE_ENV=production
PORT=4173

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
ADMIN_NAME=管理员

# 单个销售账号写法
SALES_USERNAME=sales
SALES_PASSWORD=请改成强密码
SALES_NAME=销售

# 多个销售账号写法，启用后会覆盖上面的单个销售账号。
# JSON 写法：
# SALES_USERS=[{"username":"sales01","password":"pass01","name":"张老师"},{"username":"sales02","password":"pass02","name":"李老师"}]
#
# 简写法：
# SALES_USERS=sales01:pass01:张老师;sales02:pass02:李老师

# 数据文件位置。线上部署时建议挂载持久化磁盘到 /data。
DATA_DIR=/data
RECORDS_FILE=/data/records.json

# 登录有效期，单位小时。
SESSION_TTL_HOURS=24
